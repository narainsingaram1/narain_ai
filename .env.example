# Orbit Life OS Environment Configuration
# Copy this file to .env to customize settings

# Timezone (defaults to system timezone)
# ORBIT_TIMEZONE=America/New_York

# --- 100% Free Local Ollama Settings (Default) ---
# ORBIT_MODEL=qwen3.5:4b
# ORBIT_OLLAMA_URL=http://127.0.0.1:11434
# ORBIT_KEEP_ALIVE=30m
# ORBIT_NUM_CTX=4096
# ORBIT_THINK=false

# --- Optional Free Cloud Accelerators (Zero Cost) ---
# Groq Free Tier (llama-3.3-70b-versatile, 300+ tok/s):
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Free / Paid Tier:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
